{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "npm --prefix frontend run dev -- --port ${PORT:-5173} --strictPort"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && source ../venv/bin/activate && uvicorn main:app --reload --port 8000"],
      "port": 8000
    }
  ]
}
