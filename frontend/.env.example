VITE_API_URL=http://localhost:8000

# Firebase Authentication (Módulo 1)
# Firebase Console > Configuración del proyecto > General > Tus apps > Web app > Config del SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Culqi — depósitos con tarjeta, modo prueba (Módulo 3)
VITE_CULQI_PUBLIC_KEY=

# Firebase Cloud Messaging — notificaciones push (Módulo 4)
# Firebase Console > Configuración del proyecto > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
