DATABASE_URL=postgresql://localhost/escrow_db

# Firebase Authentication (Módulo 1)
# Opción A (desarrollo local): ruta al JSON de la service account
# Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json
# Opción B (despliegue): pega el contenido completo del JSON como string en una sola línea
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# apiperu.dev — validación de DNI (Módulo 2)
# Regístrate en https://apiperu.dev y genera un token en el dashboard
# APIPERU_API_KEY=

# AWS Rekognition — comparación biométrica selfie vs. DNI (Módulo 2)
# Usuario IAM con permiso rekognition:CompareFaces
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Mercado Pago — depósitos con tarjeta, modo prueba (Módulo 3)
# Regístrate en https://www.mercadopago.com.pe/developers, credenciales de prueba en el panel
# MP_ACCESS_TOKEN=TEST-...
# Secreto del webhook (panel de MP > Webhooks > clave secreta). Valida la firma
# x-signature de las notificaciones a /billetera/webhook-mp.
# MP_WEBHOOK_SECRET=

# Seguridad
# Clave del panel/endpoints admin (header X-Admin-Key). Genera una larga y aleatoria.
# ADMIN_API_KEY=
# Orígenes permitidos para CORS, separados por coma. Sin definir cae a "*" (solo dev).
# CORS_ORIGINS=https://tuapp.vercel.app
# Tope por operación en soles (depósitos, transferencias, escrows). Default: 10000
# MONTO_MAXIMO=10000

# AWS S3 — almacenamiento privado de documentos y evidencias (recomendado en Railway)
# AWS_S3_BUCKET=
